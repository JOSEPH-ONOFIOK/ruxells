# X (Twitter) OAuth 2.0 — from developer.x.com. Leave both unset to run without
# the connect step: the form then takes the handle you type at face value.
#
# Register these exact callback URLs on the X app (App permissions: Read,
# Type of App: Web App — that is the one that issues a client secret):
#   https://<your-domain>/api/x/callback
#   http://localhost:3000/api/x/callback
#
# Production always builds the redirect from the canonical origin, never from
# the request host, so one production callback covers every domain the site
# answers on.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Signs the session cookie holding the connected X identity. 32+ random chars.
# Required in production; dev falls back to a per-process key.
SESSION_SECRET=

# The post(s) a quote has to point at, comma-separated.
#
# Full URLs or bare ids, whichever is to hand — the id is taken out of a URL
# automatically. Newest first: the first one is what the quest links to.
#
#   NEXT_PUBLIC_ACCEPTED_POSTS=https://x.com/ruxxellsHQ/status/1234567890123456789
#
# Left empty, the gate still enforces that the quote is by the connected
# account and carries the required phrase, but not WHICH post it quotes —
# so any post on the account passes. Set it once the announcement is up.
#
# NEXT_PUBLIC_ because the clearance form is a client component and needs to
# build the quote link. A post id is public the moment it is posted.
NEXT_PUBLIC_ACCEPTED_POSTS=

# Canonical origin, used for OG images and the OAuth redirect in production.
# Leave blank on Vercel: it infers the production domain. Set it only on
# another host, or to pin the origin if the production domain changes.
NEXT_PUBLIC_SITE_URL=

# Optional. When set, submissions go to a Google Apps Script web app instead of
# the local data/allowlist.json file — which is what production needs, since a
# serverless filesystem is read-only.
#
# Deploy a NEW Apps Script for Ruxxells rather than reusing another project's:
# the counter and the duplicate checks are per-sheet, so a shared sheet would
# mix two drops' entries and report both counts wrong.
GOOGLE_SHEETS_WEBAPP_URL=
